CURSOR_API_KEY=

# Required for tunnel / non-localhost access (localhost stays open for dev)
# MCP_API_KEY=
# BRIDGE_API_KEY=   # optional override; defaults to MCP_API_KEY
# MCP_ALLOWED_HOSTS=your-tunnel-host.example.com

# Model for auto-generated agent titles after the first turn (default: "default")
# AGENT_NAMING_MODEL=default

# Project allowlist (subdir names under ~/dev/mx/https unless overridden)
# ENABLED_PROJECTS=www,app,admin,email,cursor-bridge
# Absolute path overrides for repos outside PROJECTS_ROOT:
# PROJECT_PATH_OVERRIDES=cursor-bridge:/Users/you/dev/cursor-bridge

# Telegram — outbound notify + phone forum operator (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=                 # Cursor Bridge forum group id (usually -100…)
# TELEGRAM_WEBHOOK_SECRET=          # openssl rand -hex 24
# TELEGRAM_TOPIC_STATUS=            # message_thread_id for Status topic
# TELEGRAM_TOPIC_APP=               # message_thread_id for app topic
# TELEGRAM_TOPIC_WWW=               # message_thread_id for www topic
# TELEGRAM_TOPIC_ADMIN=
# TELEGRAM_TOPIC_EMAIL=
# TELEGRAM_TOPIC_CURSOR_BRIDGE=
# TELEGRAM_ALLOWED_USER_IDS=        # comma-separated; empty = any group member
# Dedicated Cloudflare hostname for the webhook (do NOT reuse mbp → :3000)
# TELEGRAM_TUNNEL_HOST=cursor-bridge.kairose.com
# TELEGRAM_WEBHOOK_PUBLIC_URL=      # default: https://$TELEGRAM_TUNNEL_HOST/cursor-bridge/telegram/webhook
# TELEGRAM_SET_WEBHOOK_ON_BOOT=1    # set to 0 to skip auto setWebhook on start
#
# Inbound photos are downloaded and passed to the Cursor agent as images.
# Voice notes / audio need Whisper (OpenAI-compatible):
# OPENAI_API_KEY=
# TELEGRAM_WHISPER_API_KEY=         # optional override of OPENAI_API_KEY
# OPENAI_BASE_URL=                  # default https://api.openai.com/v1 (Groq etc OK)
# TELEGRAM_WHISPER_MODEL=whisper-1
#
# Create missing forum topics: pnpm telegram:create-topics
# Per-agent topics (spawned on /new or first prompt; set 0 to disable):
# TELEGRAM_AGENT_TOPICS=1
# TELEGRAM_TOPIC_STORE=~/.cursor-bridge/telegram-agent-topics.json
#
# MCP stays on its own published app: cursor-mcp-bridge.kairose.com → :4243
# TUNNEL_HOST=mbp.thematrixofdestiny.com   # SwiftBar only (app on :3000)